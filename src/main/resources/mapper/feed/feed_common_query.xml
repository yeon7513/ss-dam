<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!-- 이 매퍼는 공용으로 쓸 resultMap과 sql을 모아둔 매퍼 -->
<mapper namespace="feedCommonQuery">

  <!-- 일반 사용자용 resultMap -->
  <resultMap type="UserFeedView" id="UserFeedViewMap" autoMapping="true">
    <id column="code" property="code"/>

    <!-- 회원 프로필카드 리스트 매핑 -->
    <collection property="memberProfile" javaType="MemberProfile" ofType="MemberProfile" autoMapping="true"
                columnPrefix="m_">
      <id column="code" property="code"/>
    </collection>

    <!-- 이미지 리스트 매핑 -->
    <collection property="images" javaType="ArrayList" ofType="Images" notNullColumn="path">
      <result column="target_code" property="targetCode"/>
      <result column="type" property="type"/>
      <result column="path" property="path"/>
    </collection>

    <!-- 해시태그 리스트 매핑 -->
    <collection property="hashtags" column="feed_code" javaType="ArrayList" ofType="FeedHashtag">
      <result column="fh_code" property="feedCode"/>
      <result column="tag_name" property="tagName"/>
    </collection>
  </resultMap>

  <!-- 관리자용 resultMap -->
  <!-- extends로 일반 사용자용 resultMap을 기준으로 필요한 데이터를 더 추가함 -->
  <resultMap id="AdminFeedViewMap" type="AdminFeedView" extends="UserFeedViewMap">

  </resultMap>

  <!-- select용 컬럼들 -->
  <sql id="selectColumns">
    f.*,
    member_profile.code AS m_code,
    member_profile.id AS m_id,
    member_profile.path AS m_profile_image,
  </sql>

  <!-- 관리자가 사용하는 검색 필터용 -->
  <sql id="filter">

  </sql>
</mapper>
