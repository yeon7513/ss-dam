<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
  
<mapper namespace="feedHashtag">
	<select id="searchHashtagByFeedCode" resultType="FeedHashtag">
		SELECT *
		FROM FEED_HASHTAG
		WHERE feed_code = #{feedCode}
	</select>
	
	
	<insert id="registerHashtag">
		INSERT INTO FEED_HASHTAG (feed_code, tag_name)
		VALUES (#{feedCode}, #{tagName})
	</insert>
</mapper>
  
