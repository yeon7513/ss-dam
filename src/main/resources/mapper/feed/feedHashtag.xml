<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
  
<mapper namespace="feedHashtag">
	<select id="seacrchHashtagByFeedCode" resultType="FeedHashtag">
		SELECT *
		FROM feed_hashtag
		WHERE feed_code = #{feedCode}
	</select>
</mapper>
  
