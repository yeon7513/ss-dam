<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="marketHitcount">

  <insert id="registerProductHitCount">
    <!-- INSERT IGNORE -> 존재하면? 삽입 무시 -->
    INSERT IGNORE INTO MARKET_PROD_HIT_LOG
    (prod_code, mem_code, created_at)
    VALUES
    (#{prodCode}, #{memCode}, NOW())
  </insert>

</mapper>
