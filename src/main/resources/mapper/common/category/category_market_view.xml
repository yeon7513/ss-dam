<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="categoryMarketView">

  <!-- 마켓용 카테고리 resultMap -->
  <resultMap id="UserMarketCategoriesMap" type="UserMarketCategoryView" autoMapping="true">
    <id column="code" property="code" />

    <collection property="depth" columnPrefix="sub_" javaType="ArrayList" ofType="Category" autoMapping="true">
      <id column="code" property="code" />
    </collection>
  </resultMap>

  <resultMap id="AdminMarketCategoriesMap" type="AdminMarketCategoryView" extends="UserMarketCategoriesMap"
             autoMapping="true">
    <id column="code" property="code" />
  </resultMap>

  <!-- 공통으로 사용할 컬럼 -->
  <sql id="categoryMarketBasicColumns">
    main.code,
    main.name,
    sub.code AS sub_code,
    sub.name AS sub_name
  </sql>

  <!-- ================================================= -->


  <!-- 물품 등록 및 조회용 마켓 카테고리 선택 (상위 & 하위, 활성중인 카테고리만) -->
  <select id="loadActiveMarketCategories" resultMap="UserMarketCategoriesMap">
    SELECT
    <include refid="categoryMarketBasicColumns" />
    FROM MARKET_CATEGORY AS main
    <!-- 하위 카테고리 셀프 조인 -->
    JOIN MARKET_CATEGORY AS sub
    ON main.code = sub.main_cate
    WHERE main.status = 'active'
    AND main.delete_yn = 0
    AND sub.status = 'active'
    AND sub.delete_yn = 0
  </select>

  <!-- 전체 마켓 카테고리 조회 (관리자용) -->
  <select id="loadAllMarketCategories" resultMap="AdminMarketCategoriesMap">
    SELECT
    <include refid="categoryMarketBasicColumns" />,
    main.status,
    main.created_by,
    main.created_at,
    main.updated_by,
    main.updated_at,
    main.delete_yn,
    sub.status AS sub_status,
    sub.delete_yn AS sub_delete_yn
    FROM MARKET_CATEGORY AS main
    LEFT JOIN MARKET_CATEGORY AS sub
    ON main.code = sub.main_cate
    WHERE main.main_cate IS NULL
  </select>

</mapper>
