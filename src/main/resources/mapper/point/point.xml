<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="userPoint">

  <select id="getPointBalance" resultType="int">
    SELECT POINT
    FROM MEMBER_ACCOUNT
    WHERE CODE = #{code}
  </select>

</mapper>
