<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="adminMember">

    <!-- 회원 목록 응답 매핑 -->
    <resultMap id="adminMemberViewMap"
               type="AdminMemberView"
               autoMapping="true">
        <id column="CODE" property="code"/>
    </resultMap>

  
    <!-- 목록·건수 조회에 공통 적용할 검색 조건 -->

    <!-- 여러 쿼리에서 반복되는 조건을 이름 붙여 저장하는 MyBatis 공통 SQL  조각-->
    <!-- 실행할 때, <include>자리에 위의 WHERE(...)전체가 들어가므로 기존쿼리와 동일하게 동작 -->

    <sql id="memberSearchConditions">
        <where>

            <!-- 아이디 / 이름 / 연락처 검색 -->
            <if test="filter.keyword != null
                    and filter.keyword.trim() != ''">
                <choose>
                    <when test='filter.search == "name"'>
                        AND m.NAME LIKE CONCAT('%', #{filter.keyword}, '%')
                    </when>

                    <when test='filter.search == "phone"'>
                        AND REPLACE(m.PHONE, '-', '')
                            LIKE CONCAT(
                                '%',
                                REPLACE(#{filter.keyword}, '-', ''),
                                '%'
                            )
                    </when>

                    <otherwise>
                        AND m.ID LIKE CONCAT('%', #{filter.keyword}, '%')
                    </otherwise>
                </choose>
            </if>

            <!-- 회원 구분: null이면 전체 -->
            <if test="filter.status != null">
                <choose>

                    <!-- 일반 -->
                    <when test="filter.status.name() == 'NORMAL'">
                        AND m.STATUS = 'ACTIVE'
                        AND m.DELETE_YN = 0
                    </when>

                    <!-- 정지 -->
                    <when test="filter.status.name() == 'SUSPENDED'">
                        AND m.STATUS = 'SUSPENDED'
                        AND m.DELETE_YN = 0
                    </when>

                    <!-- 휴면 -->
                    <when test="filter.status.name() ==  'SLEEP'">
                        AND m.STATUS = 'SLEEP'
                        AND m.DELETE_YN = 0
                    </when>

                    <!-- 탈퇴-->
                    <when test="filter.status.name() == 'WITHDRAWN'">
                        AND m.DELETE_YN = 1
                    </when>

                </choose>
            </if>

            <!-- 가입일 시작일 포함 -->
            <if test="filter.joinedFrom != null">
                AND m.CREATED_AT &gt;= #{filter.joinedFrom}
            </if>

            <!-- 가입일 종료일 당일까지 포함 -->
            <if test="filter.joinedTo != null">
                AND m.CREATED_AT &lt;
                    DATE_ADD(#{filter.joinedTo}, INTERVAL 1 DAY)
            </if>

            <!-- 등급 -->
            <if test="filter.rating != null">
                AND m.RATING = #{filter.rating}
            </if>

            <!-- 주소 기준 시·도 검색 -->
            <if test="filter.regionCode != null and filter.regionCode != ''">
                <choose>
                    <when test='filter.regionCode == "충북"'>
                        AND (m.ADDRESS LIKE '충북%' OR m.ADDRESS LIKE '충청북도%')
                    </when>
                    <when test='filter.regionCode == "충남"'>
                        AND (m.ADDRESS LIKE '충남%' OR m.ADDRESS LIKE '충청남도%')
                    </when>
                    <when test='filter.regionCode == "전북"'>
                        AND (m.ADDRESS LIKE '전북%' OR m.ADDRESS LIKE '전라북도%')
                    </when>
                    <when test='filter.regionCode == "전남"'>
                        AND (m.ADDRESS LIKE '전남%' OR m.ADDRESS LIKE '전라남도%')
                    </when>
                    <when test='filter.regionCode == "경북"'>
                        AND (m.ADDRESS LIKE '경북%' OR m.ADDRESS LIKE '경상북도%')
                    </when>
                    <when test='filter.regionCode == "경남"'>
                        AND (m.ADDRESS LIKE '경남%' OR m.ADDRESS LIKE '경상남도%')
                    </when>
                    <otherwise>
                        AND m.ADDRESS LIKE CONCAT(#{filter.regionCode}, '%')
                    </otherwise>
                </choose>
            </if>
            
            <!-- 최근 접속 -->
            <if test="filter.activityStatus != null
                    and filter.activityStatus != ''">
                <choose>
                    <!-- 최근 7일 이내 -->
                    <when test='filter.activityStatus == "WITHIN_7_DAYS"'>
                        AND m.LOGGED_AT &gt;= DATE_SUB(NOW(), INTERVAL 7 DAY)
                    </when>

                    <!-- 7일 초과, 30일 이내 -->
                    <when test='filter.activityStatus == "BETWEEN_7_30_DAYS"'>
                        AND m.LOGGED_AT &lt; DATE_SUB(NOW(), INTERVAL 7 DAY)
                        AND m.LOGGED_AT &gt;= DATE_SUB(NOW(), INTERVAL 30 DAY)
                    </when>

                    <!-- 30일 초과 -->
                    <when test='filter.activityStatus == "OVER_30_DAYS"'>
                        AND m.LOGGED_AT &lt; DATE_SUB(NOW(), INTERVAL 30 DAY)
                    </when>

                    <!-- 접속 기록 없음 -->
                    <when test='filter.activityStatus == "NEVER"'>
                        AND m.LOGGED_AT IS NULL
                    </when>
                </choose>
            </if>
        </where>
    </sql>

    <!-- 검색 조건에 맞는 전체 회원 수 -->
    <select id="countMembers"
            parameterType="map"
            resultType="int">

        SELECT COUNT(*)
        FROM MEMBER_ACCOUNT m

        <include refid="memberSearchConditions"/>
    </select>

    <!-- 회원 목록 조회 -->
    <select id="loadMembers"
            parameterType="map"
            resultMap="adminMemberViewMap">

        SELECT
            m.CODE,
            m.ID,
            m.NAME,
            m.ADDRESS,
            m.STATUS,
            m.RATING,
            m.RANKING,
            m.CREATED_AT,
            m.LOGGED_AT,
            m.DELETE_YN
        FROM MEMBER_ACCOUNT m

        <include refid="memberSearchConditions"/>

        ORDER BY m.CREATED_AT DESC, m.CODE DESC
        LIMIT #{perPage} OFFSET #{offset}
    </select>


    <!-- 회원 상세 정보 매핑 -->
<resultMap id="adminMemberDetailViewMap"
           type="AdminMemberDetailView"
           autoMapping="true">

    <id column="CODE" property="code"/>
    <!--DTO필드명이 profilePath로 변환되는 path는 AS path-->
</resultMap>

<!-- 관리자 회원 상세 조회 -->
<!--경로 하나만 필요해서 LEFT JOIN으로 쓰면 코드가 복잡해져서 서브쿼리 유지 -->
<select id="loadMember"
        parameterType="long"
        resultMap="adminMemberDetailViewMap">
    SELECT
        m.CODE,
        m.ID,
        m.NAME,
        m.PHONE,
        m.ADDRESS,
        m.RATING,
        m.POINT,
        m.STATUS,
        m.CREATED_AT,
        m.UPDATED_AT,
        m.LOGGED_AT,
        m.DELETE_YN,
        (
            SELECT i.PATH
            FROM IMAGES i
            WHERE i.TARGET_CODE = m.CODE
              AND i.TYPE = 'profile'
              AND i.DELETE_YN = 0
            ORDER BY i.ORDER_SEQ ASC, i.PATH ASC
            LIMIT 1
        ) AS path
    FROM MEMBER_ACCOUNT m
    WHERE m.CODE = #{memberCode}

    <!--사진은 서브쿼리로 한 건만 가져옴
    - 사진이 여러 개여도 회원 정보가 중복되지 않고, 사진이 없으면 path가 null로 반환
    - 순서가 가장 작은 사진을 선택하고, 같은 순서면 경로순으로 선택-->

</select>


<!-- 회원이 완료한 챌린지 수 -->
<select id="countCompletedChallenges"
        parameterType="long"
        resultType="long">

    SELECT COUNT(DISTINCT ce.CHAL_CODE)
    FROM CHALLENGE_ENTRY ce

    INNER JOIN CHALLENGE c
        ON c.CODE = ce.CHAL_CODE

    WHERE ce.MEM_CODE = #{memberCode}
      AND ce.STATUS = 'COMPLETED'
      AND ce.CANCELED_AT IS NULL
      AND c.DELETE_YN = 0

<!-- CHALLENGE 자체의 DELETE_YN은 유지하고,
 참여 기록은 STATUS = 'COMPLETED'와 CANCELED_AT IS NULL로 
 유효한 완료 기록을 판단-->      
<!--COUNT(DISTINCT ce.CHAL_CODE)는 같은 챌린지의 완료 기록이 여러 개여도 한 번만 - 여기서는 종료일 대신 참여 상태 COMPLETED를 완료 기준으로 사용-->

</select>


<!-- 상세 조회 - 상단 통계 -->

<!--
    받은 신고 누적 수
    feed, comment는 실제 TARGET_TYPE 값 확인 필요
-->
<select id="countReceivedReports"
        parameterType="long"
        resultType="long">

    SELECT COUNT(*)
    FROM REPORT r
    WHERE
        (
            r.TARGET_TYPE = 'feed'
            AND EXISTS (
                SELECT 1
                FROM FEED f
                WHERE f.CODE = r.TARGET_CODE
                  AND f.MEM_CODE = #{memberCode}
            )
        )
        OR
        (
            r.TARGET_TYPE = 'comment'
            AND EXISTS (
                SELECT 1
                FROM COMMENTS c
                WHERE c.CODE = r.TARGET_CODE
                  AND c.MEM_CODE = #{memberCode}
            )
        )
        OR
        (
            r.TARGET_TYPE = 'market'
            AND EXISTS (
                SELECT 1
                FROM MARKET_PRODUCT p
                WHERE p.CODE = r.TARGET_CODE
                  AND p.MEM_CODE = #{memberCode}
            )
        )
<!--신고 한 건을 1회로 계산
 처리 상태와 관계없이 집계하고, 대상 글이 soft delete된 경우도 포함-->
</select>

<!--회원이 작성한 삭제되지 않은 피드 수 (비공개 포함)-->
<select id="countMemberFeeds"
        parameterType="long"
        resultType="long">

    SELECT COUNT(*)
    FROM FEED
    WHERE MEM_CODE = #{memberCode}
      AND DELETE_YN = 0

</select>


<!-- 회원이 구매자 또는 판매자로 참여한 거래 이력 수 -->
<select id="countMemberTrades"
        parameterType="long"
        resultType="long">

    SELECT COUNT(*)
    FROM MARKET_DEAL_LOG d
    WHERE EXISTS (
        SELECT 1
        FROM MEMBER_ACCOUNT m
        WHERE m.CODE = #{memberCode}
          AND (
              d.SELLER_ID = m.ID
              OR d.BUYER_ID = m.ID
          )
    )
<!--MARKET_DEAL_LOG 조회 쿼리-->
</select>

<!-- 회원 로그인 성공 횟수 -->
<select id="countMemberLogins"
        parameterType="long"
        resultType="long">

    SELECT COUNT(*)
    FROM MEMBER_ACTIVITY_LOG
    WHERE MEM_CODE = #{memberCode}
      AND ACTION_TYPE = 'LOGIN_SUCCESS'

<!--MEMBER_ACTIVITY_LOG 활용-->
</select>

<!--
    정지: ACTIVE → SUSPENDED
    해제: SUSPENDED → ACTIVE
    삭제 여부는 변경하지 않음
-->
<update id="updateMemberStatus" parameterType="map">

    UPDATE MEMBER_ACCOUNT
    SET STATUS = #{afterStatus},
        UPDATED_AT = NOW()
    WHERE CODE = #{memberCode}
      AND STATUS = #{beforeStatus}
      AND DELETE_YN = 0

</update>

<!-- 관리자 회원 상태 변경 이력 -->
<insert id="insertMemberStatusLog" parameterType="map">

    INSERT INTO ADMIN_ACTIVITY_LOG (
        ADM_CODE,
        TARGET_TYPE,
        TARGET_CODE,
        PROCESS_TYPE,
        MEMO,
        CREATED_AT
    )
    VALUES (
        #{adminCode},
        'member',
        #{memberCode},
        #{processType},
        #{reason},
        NOW()
    )

</insert>

</mapper>

<!--지역은 우선 ADDRESS를 반환, 랭킹 컬럼 없음?-->