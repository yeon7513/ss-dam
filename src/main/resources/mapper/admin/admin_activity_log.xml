<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="adminActivityLog">

    <!-- 관리자 처리 이력 응답 매핑 -->
    <resultMap id="adminActivityMap"
               type="com.ss_dam.admin.log.response.AdminActivity">

        <id column="CODE" property="code"/>
        <result column="ADMIN_ID" property="empId"/>
        <result column="TARGET_TYPE" property="targetType"/>
        <result column="TARGET_CODE" property="targetCode"/>
        <result column="PROCESS_TYPE" property="processType"/>
        <result column="MEMO" property="memo"/>
        <result column="CREATED_AT" property="createdAt"/>

    </resultMap>

    <!-- 회원 정지·해제 이력 공통 조건 -->
    <sql id="memberLogConditions">

        WHERE l.TARGET_TYPE = 'member'
          AND l.TARGET_CODE = #{memberCode}
          AND l.PROCESS_TYPE IN ('RESTRICT', 'RELEASE')

    </sql>

    <!-- 회원 정지·해제 이력 전체 건수 -->
    <select id="countMemberLogs"
            parameterType="map"
            resultType="int">

        SELECT COUNT(*)
        FROM ADMIN_ACTIVITY_LOG l

        <include refid="memberLogConditions"/>

    </select>

    <!-- 회원 정지·해제 이력 목록 -->
    <select id="loadMemberLogs"
            parameterType="map"
            resultMap="adminActivityMap">

        SELECT
            l.CODE,
            a.EMP_ID AS ADMIN_ID,
            l.TARGET_TYPE,
            l.TARGET_CODE,
            l.PROCESS_TYPE,
            l.MEMO,
            l.CREATED_AT

        FROM ADMIN_ACTIVITY_LOG l

        LEFT JOIN ADMIN_ACCOUNT a
            ON a.CODE = l.ADM_CODE

        <include refid="memberLogConditions"/>

        ORDER BY l.CREATED_AT DESC, l.CODE DESC
        LIMIT #{perPage} OFFSET #{offset}

    </select>

    <!-- 챌린지 처리 이력 공통 조건 -->
    <sql id="challengeLogConditions">

        WHERE l.TARGET_TYPE = 'challenge'
          AND l.TARGET_CODE = #{code}

    </sql>

    <!-- 챌린지 처리 이력 전체 건수 -->
    <select id="countChallengeLogs"
            parameterType="map"
            resultType="long">

        SELECT COUNT(*)
        FROM ADMIN_ACTIVITY_LOG l

        <include refid="challengeLogConditions"/>

    </select>

    <!-- 챌린지 처리 이력 목록 -->
    <select id="loadChallengeLogs"
            parameterType="map"
            resultMap="adminActivityMap">

        SELECT
            l.CODE,
            a.EMP_ID AS ADMIN_ID,
            l.TARGET_TYPE,
            l.TARGET_CODE,
            l.PROCESS_TYPE,
            l.MEMO,
            l.CREATED_AT

        FROM ADMIN_ACTIVITY_LOG l

        LEFT JOIN ADMIN_ACCOUNT a
            ON a.CODE = l.ADM_CODE

        <include refid="challengeLogConditions"/>

        ORDER BY l.CREATED_AT DESC, l.CODE DESC
        LIMIT #{perPage} OFFSET #{offset}

    </select>

    <!-- 관리자 처리 이력 저장 -->
    <insert id="insertActivityLog" parameterType="map">

        INSERT INTO ADMIN_ACTIVITY_LOG (
            ADM_CODE,
            TARGET_TYPE,
            TARGET_CODE,
            PROCESS_TYPE,
            MEMO,
            CREATED_AT
        )
        VALUES (
            #{adminCode},
            #{targetType},
            #{targetCode},
            #{processType},
            #{memo},
            #{createdAt}
        )

    </insert>

</mapper>