<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="adminMember">

    <!-- 회원 목록 응답 매핑 -->
    <resultMap id="adminMemberViewMap"
               type="AdminMemberView">

        <id column="CODE" property="code"/>
        <result column="ID" property="id"/>
        <result column="NAME" property="name"/>
        <result column="ADDRESS" property="address"/>
        <result column="STATUS" property="status"/>
        <result column="RATING" property="rating"/>
        <result column="CREATED_AT" property="createdAt"/>
        <result column="DELETE_YN" property="deleteYn"/>
    </resultMap>

    <!-- 목록·건수 조회에 공통 적용할 검색 조건 -->
    <sql id="memberSearchConditions">
        <where>

            <!-- 아이디 검색 -->
            <if test="filter.keyword != null
                      and filter.keyword.trim() != ''">
                AND 
                    m.ID LIKE CONCAT('%', #{filter.keyword}, '%')
                    
                
            </if>

            <!-- 회원 구분: null이면 전체 -->
            <if test="filter.status != null">
                <choose>

                    <!-- 일반 -->
                    <when test="filter.status.name() == 'NORMAL'">
                        AND m.STATUS = 'ACTIVE'
                        AND m.DELETE_YN = 0
                    </when>

                    <!-- 정지 -->
                    <when test="filter.status.name() == 'SUSPENDED'">
                        AND m.STATUS = 'SUSPENDED'
                        AND m.DELETE_YN = 0
                    </when>

                    <!-- 탈퇴를 soft delete로 관리하는 기준 -->
                    <when test="filter.status.name() == 'WITHDRAWN'">
                        AND m.DELETE_YN = 1
                    </when>

                </choose>
            </if>

            <!-- 가입일 시작일 포함 -->
            <if test="filter.joinedFrom != null">
                AND m.CREATED_AT &gt;= #{filter.joinedFrom}
            </if>

            <!-- 가입일 종료일 당일까지 포함 -->
            <if test="filter.joinedTo != null">
                AND m.CREATED_AT &lt;
                    DATE_ADD(#{filter.joinedTo}, INTERVAL 1 DAY)
            </if>

            <!-- 등급 -->
            <if test="filter.rating != null">
                AND m.RATING = #{filter.rating}
            </if>

        </where>
    </sql>

    <!-- 검색 조건에 맞는 전체 회원 수 -->
    <select id="countMembers"
            parameterType="map"
            resultType="int">

        SELECT COUNT(*)
        FROM MEMBER_ACCOUNT m

        <include refid="memberSearchConditions"/>
    </select>

    <!-- 회원 목록 조회 -->
    <select id="loadMembers"
            parameterType="map"
            resultMap="adminMemberViewMap">

        SELECT
            m.CODE,
            m.ID,
            m.NAME,
            m.ADDRESS,
            m.STATUS,
            m.RATING,
            m.CREATED_AT,
            m.DELETE_YN
        FROM MEMBER_ACCOUNT m

        <include refid="memberSearchConditions"/>

        ORDER BY m.CREATED_AT DESC, m.CODE DESC
        LIMIT #{perPage} OFFSET #{offset}
    </select>


    <!-- 회원 상세 정보 매핑 -->
<resultMap id="adminMemberDetailViewMap"
           type="com.ss_dam.auth.member.model.response.AdminMemberDetailView">

    <id column="CODE" property="code"/>
    <result column="ID" property="id"/>
    <result column="NAME" property="name"/>
    <result column="PHONE" property="phone"/>
    <result column="ADDRESS" property="address"/>
    <result column="RATING" property="rating"/>
    <result column="POINT" property="point"/>
    <result column="STATUS" property="status"/>
    <result column="CREATED_AT" property="createdAt"/>
    <result column="UPDATED_AT" property="updatedAt"/>
    <result column="LOGGED_AT" property="loggedAt"/>
    <result column="DELETE_YN" property="deleteYn"/>
    <result column="PROFILE_PATH" property="path"/>
</resultMap>

<!-- 관리자 회원 상세 조회 -->
<select id="loadMember"
        parameterType="long"
        resultMap="adminMemberDetailViewMap">

    SELECT
        m.CODE,
        m.ID,
        m.NAME,
        m.PHONE,
        m.ADDRESS,
        m.RATING,
        m.POINT,
        m.STATUS,
        m.CREATED_AT,
        m.UPDATED_AT,
        m.LOGGED_AT,
        m.DELETE_YN,

        (
            SELECT i.PATH
            FROM IMAGES i
            WHERE i.TARGET_CODE = m.CODE
              AND i.TYPE = 'profile'
              AND i.DELETE_YN = 0
            ORDER BY i.ORDER_SEQ ASC, i.PATH ASC
            LIMIT 1
        ) AS PROFILE_PATH

    FROM MEMBER_ACCOUNT m
    WHERE m.CODE = #{memberCode}

</select>
<!--사진은 서브쿼리로 한 건만 가져옴
- 사진이 여러 개여도 회원 정보가 중복되지 않고, 사진이 없으면 path가 null로 반환
- 순서가 가장 작은 사진을 선택하고, 같은 순서면 경로순으로 선택-->

<!-- 상세 조회 - 상단 통계 - 상단 통계 - 
삭제 되지 않은 회원이 작성한 피드 수 (비공개까지 포함)-->
<select id="countMemberFeeds"
        parameterType="long"
        resultType="long">

    SELECT COUNT(*)
    FROM FEED
    WHERE MEM_CODE = #{memberCode}
      AND DELETE_YN = 0

</select>

<!--
    받은 신고 누적 수
    feed, comment는 실제 TARGET_TYPE 값 확인 필요
-->
<select id="countReceivedReports"
        parameterType="long"
        resultType="long">

    SELECT COUNT(*)
    FROM REPORT r
    WHERE
        (
            r.TARGET_TYPE = 'feed'
            AND EXISTS (
                SELECT 1
                FROM FEED f
                WHERE f.CODE = r.TARGET_CODE
                  AND f.MEM_CODE = #{memberCode}
            )
        )
        OR
        (
            r.TARGET_TYPE = 'comment'
            AND EXISTS (
                SELECT 1
                FROM COMMENTS c
                WHERE c.CODE = r.TARGET_CODE
                  AND c.MEM_CODE = #{memberCode}
            )
        )
        OR
        (
            r.TARGET_TYPE = 'market'
            AND EXISTS (
                SELECT 1
                FROM MARKET_PRODUCT p
                WHERE p.CODE = r.TARGET_CODE
                  AND p.MEM_CODE = #{memberCode}
            )
        )
<!--신고 한 건을 1회로 계산
 처리 상태와 관계없이 집계하고, 대상 글이 soft delete된 경우도 포함-->
</select>

<!-- 회원이 구매자 또는 판매자로 참여한 거래 이력 수 -->
<select id="countMemberTrades"
        parameterType="long"
        resultType="long">

    SELECT COUNT(*)
    FROM MARKET_DEAL_LOG d
    WHERE EXISTS (
        SELECT 1
        FROM MEMBER_ACCOUNT m
        WHERE m.CODE = #{memberCode}
          AND (
              d.SELLER_ID = m.ID
              OR d.BUYER_ID = m.ID
          )
    )
<!--MARKET_DEAL_LOG 조회 쿼리-->
</select>

<!-- 회원 로그인 성공 횟수 -->
<select id="countMemberLogins"
        parameterType="long"
        resultType="long">

    SELECT COUNT(*)
    FROM MEMBER_ACTIVITY_LOG
    WHERE MEM_CODE = #{memberCode}
      AND ACTION_TYPE = 'LOGIN_SUCCESS'

<!--MEMBER_ACTIVITY_LOG 활용-->
</select>



</mapper>

<!--지역은 우선 ADDRESS를 반환, 랭킹 컬럼 없음?-->