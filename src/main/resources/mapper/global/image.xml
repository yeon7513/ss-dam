<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="image">
	
	<select id="searchFeedImagesByFeedCode" resultType="Images">
		SELECT *
		FROM images
		WHERE type = 'feed' AND target_code = #{feedCode}
	</select>

</mapper>
