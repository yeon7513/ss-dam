<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
  
<mapper namespace="chal_entry">
	<select id="findAll" resultType="ChallengeEntry">
	SELECT * 
	FROM CHALLENGE_ENTRY ce 
	ORDER BY joined_at DESC
	</select>
</mapper>